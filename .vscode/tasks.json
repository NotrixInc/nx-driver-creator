{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "npm: watch",
      "type": "npm",
      "script": "watch",
      "problemMatcher": "$tsc-watch",
      "isBackground": true,
      "presentation": {
        "reveal": "never"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "npm: compile",
      "type": "npm",
      "script": "compile",
      "problemMatcher": "$tsc",
      "group": "build"
    },
    {
      "label": "npm: devhost",
      "type": "npm",
      "script": "devhost",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    },
    {
      "label": "Launch Extension Dev Host",
      "type": "shell",
      "command": "code --new-window --extensionDevelopmentPath=\"${workspaceFolder}\" \"${workspaceFolder}\"",
      "problemMatcher": [],
      "presentation": {
        "reveal": "always"
      }
    }
  ]
}
